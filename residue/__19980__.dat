work|$ OUT="$HOME/worldsphere-residue-inventory-$(date +%Y%m%d-%H%M%S).txt"

{
  echo "=== WORLDSphere RESIDUE INVENTORY ==="
  date -Is
  echo "Host: $(hostname)"
  echo "User: $(whoami)"
  echo "Root: /var/www/worldsphere"

  echo
  echo "=== WORKTREE STATUS ==="
  for d in pro-bowling-3d integration release-1 staging; do
    echo "--- $d ---"
    git -C "/var/www/worldsphere/$d" status --short --branch --untracked-files=all
  done

  echo
  echo "=== GIT STASHES ==="
  git -C /var/www/worldsphere/pro-bowling-3d stash list --date=iso
  git -C /var/www/worldsphere/pro-bowling-3d stash show --stat --include-untracked 'stash@{0}'

  echo
  echo "=== TOP-LEVEL WORLDSPHERE CONTENTS ==="
  ls -la /var/www/worldsphere

  echo
  echo "=== STAGING RESIDUE ==="
  find /var/www/worldsphere/staging -maxdepth 3 -type f \
    -printf '%p | %s bytes | %TY-%Tm-%Td %TH:%TM:%TS\n' | sort

  echo
  echo "=== LIVE REPO RESIDUE ==="
  find /var/www/worldsphere/pro-bowling-3d -maxdepth 2 -type f \
    \( -path '*/temp/*' -o -name 'review__init__html.dat' \) \
    -printf '%p | %s bytes | %TY-%Tm-%Td %TH:%TM:%TS\n' | sort

  echo
  echo "=== HISTORY DIRECTORY ==="
  find /var/www/worldsphere/history -maxdepth 2 -type f \
    -printf '%p | %s bytes | %TY-%Tm-%Td %TH:%TM:%TS\n' 2>/dev/null | sort

  echo
echo "INVENTORY SAVED: $OUT"es-available/default*0219/"
